{
  "name": "songbattle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "pnpm --filter @songbattle/backend build && pnpm --filter @songbattle/frontend build",
    "dev": "pnpm --parallel --recursive --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --filter @songbattle/backend test && pnpm --filter @songbattle/frontend test",
    "typecheck": "pnpm --filter @songbattle/contracts typecheck && pnpm --filter @songbattle/backend typecheck && pnpm --filter @songbattle/frontend typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4"
  }
}
