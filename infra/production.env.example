# Copy to ~/projects/songbattle/production.env on the VM and fill the secrets.
SONGBATTLE_DOMAIN=replace-with-production-domain
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=DE
SONG_POOL_MAX_SIZE=20000
SONG_CACHE_TTL_SECONDS=86400
SPOTIFY_MAX_ATTEMPTS=3
SPOTIFY_MAX_RETRY_DELAY_SECONDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
