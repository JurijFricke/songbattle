[Unit]
Description=SongBattle web and Caddy reverse proxy
Requires=songbattle-network.service songbattle-api.service
After=songbattle-network.service songbattle-api.service

[Container]
Image=localhost/songbattle-web:latest
ContainerName=songbattle-web
Network=songbattle.network
EnvironmentFile=%h/projects/songbattle/production.env
PublishPort=80:80
PublishPort=443:443
Volume=%h/projects/songbattle/caddy-data:/data
Volume=%h/projects/songbattle/caddy-config:/config
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
